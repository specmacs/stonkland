# Contract addresses. Every one of these is required before the interface will enable a
# transaction control. An absent address disables the control and says so on the page --
# it never falls back to a hardcoded address and never guesses.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=

NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_NFT_ADDRESS=
NEXT_PUBLIC_MINTER_ADDRESS=
NEXT_PUBLIC_PROGRESSION_MANAGER_ADDRESS=
NEXT_PUBLIC_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_EDITION_REGISTRY_ADDRESS=
NEXT_PUBLIC_REVENUE_VAULT_ADDRESS=
NEXT_PUBLIC_STREAM_VAULT_ADDRESS=
NEXT_PUBLIC_FEE_ROUTER_ADDRESS=
NEXT_PUBLIC_ROYALTY_ROUTER_ADDRESS=
NEXT_PUBLIC_WETH_ADDRESS=

# One reward asset per quarter.
NEXT_PUBLIC_REWARD_ASSET_Q1=
NEXT_PUBLIC_REWARD_ASSET_Q2=
NEXT_PUBLIC_REWARD_ASSET_Q3=
NEXT_PUBLIC_REWARD_ASSET_Q4=

# Optional.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_POOL_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_SITE_URL=

# Launch phase: "curve" while the token is on its bonding curve, "graduated" once a
# pool exists. Set deliberately; the interface will not guess it.
NEXT_PUBLIC_LAUNCH_PHASE=curve
