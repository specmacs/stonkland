# Deployment configuration for the founding edition.
#
# Copy to .env and fill in. Values marked SETTLED are decided; values marked OUTSTANDING
# block the deployment and are listed again at the bottom with what is needed to close
# each one.

# --- SETTLED ------------------------------------------------------------------------

TOKEN_NAME="Stocktown"
TOKEN_SYMBOL="TOWN"
NFT_NAME="Stocktown Property Card"
NFT_SYMBOL="CARD"

# Holds every admin role: pause, processor, renderer, edition registration.
# Use a hardware wallet. If this key is lost, no future edition can ever be registered.
OWNER=0xE8935F4dF6cE0bd53BA16FfB7D08Da602647F916

# Receives the treasury's share of fees, less the buyback.
TREASURY_SINK=0xA4C7CEd2792F0D535eFab963984527F1ABFeA9BE

# Share of treasury revenue spent buying TOWN back. Everything bought is destroyed.
BUYBACK_BPS=2000
BUYBACK_BURNS=true
# Unused while BUYBACK_BURNS is true, and rejected by the constructor if set anyway.
# BUYBACK_RECIPIENT=

# 1.25x, baked into every stored weight at mint. Immutable per edition.
WEIGHT_MULTIPLIER_BPS=12500

# No team allocation. The full supply goes to the address that will create the pool;
# there is no reserved-card mechanism anywhere in the contracts.
TOKEN_RECIPIENT=0xA4C7CEd2792F0D535eFab963984527F1ABFeA9BE

# --- Robinhood Chain, read off the chain and confirmed by the fork tests --------------
#
# Chain id 4663, native ETH. RPC https://rpc.mainnet.chain.robinhood.com
# See docs/chain-notes.md for how each of these was established and what to re-check.
#
# Impostor tokens carrying these exact symbols also trade on this chain. Never resolve
# one of these by ticker. The addresses are what matter.

# NVIDIA, Robinhood token
REWARD_ASSET_Q1=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# Alphabet Class A, Robinhood token
REWARD_ASSET_Q2=0x2e0847E8910a9732eB3fb1bb4b70a580ADAD4FE3
# Apple, Robinhood token
REWARD_ASSET_Q3=0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9
# Meta Platforms, Robinhood token
REWARD_ASSET_Q4=0xc0D6457C16Cc70d6790Dd43521C899C87ce02f35

WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# The venue's fee claim, if it has one. Leave unset if fees arrive at the router without
# needing to be pulled.
# FEE_SOURCE=

IMAGE_BASE_URI=
EXTERNAL_BASE_URI=

# Pons swap router, a genuine Uniswap V3 SwapRouter: factory() and WETH9() both resolve
# to the addresses above. This is what the acquisition adapters trade through.
SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2

# --- OUTSTANDING ---------------------------------------------------------------------
#
# 1. Which Pons version the launch uses, V1 or V2. It changes the numbers above:
#      V1  direct Uniswap V3 pool against WETH, 1% fee, 70% to the creator
#      V2  bonding curve graduating into a locked Uniswap V4 pool, base fee plus an
#          optional creator tax, and a wider choice of pairing asset
#    The escrow address here is V2's.
#
# 2. Whether a creator tax is being set on a V2 launch, and at what rate. It is fixed at
#    launch and cannot be changed afterwards.
#
# 3. Whether the issuer's terms permit a protocol to acquire and redistribute the
#    tokenized equities. The fork tests establish that a contract *can* hold and forward
#    them. They say nothing about whether it *may*, which is a question for Robinhood and
#    for counsel.
