# Deployment configuration for the founding edition.
#
# Copy to .env and fill in. Values marked SETTLED are decided; values marked OUTSTANDING
# block the deployment and are listed again at the bottom with what is needed to close
# each one.

# --- SETTLED ------------------------------------------------------------------------

TOKEN_NAME="Stocktown"
TOKEN_SYMBOL="TOWN"
NFT_NAME="Stocktown Property Card"
NFT_SYMBOL="CARD"

# Holds every admin role: pause, processor, renderer, edition registration.
# Use a hardware wallet. If this key is lost, no future edition can ever be registered.
OWNER=0xE8935F4dF6cE0bd53BA16FfB7D08Da602647F916

# Receives the treasury's share of fees, less the buyback.
TREASURY_SINK=0xA4C7CEd2792F0D535eFab963984527F1ABFeA9BE

# Share of treasury revenue spent buying TOWN back. Everything bought is destroyed.
BUYBACK_BPS=2000
BUYBACK_BURNS=true
# Unused while BUYBACK_BURNS is true, and rejected by the constructor if set anyway.
# BUYBACK_RECIPIENT=

# 1.25x, baked into every stored weight at mint. Immutable per edition.
WEIGHT_MULTIPLIER_BPS=12500

# No team allocation. The full supply goes to the address that will create the pool;
# there is no reserved-card mechanism anywhere in the contracts.
TOKEN_RECIPIENT=0xA4C7CEd2792F0D535eFab963984527F1ABFeA9BE

# --- OUTSTANDING --------------------------------------------------------------------

# The four reward assets: tokenized NVIDIA, Alphabet, Apple and Meta, one per quarter.
# These must be the token contract addresses on the deployment chain.
REWARD_ASSET_Q1=
REWARD_ASSET_Q2=
REWARD_ASSET_Q3=
REWARD_ASSET_Q4=

# Wrapped native asset on the deployment chain. Every conversion route starts here.
WETH=

# The venue's fee claim, if it has one. Leave unset if fees arrive at the router
# without needing to be pulled.
# FEE_SOURCE=

IMAGE_BASE_URI=
EXTERNAL_BASE_URI=

# --- Still needed before this file is complete ---------------------------------------
#
# 1. Chain id and RPC url for the deployment chain.
# 2. The four reward-asset token addresses above.
# 3. The wrapped native asset address.
# 4. The DEX router address and the pool fee tier for each of the four routes.
# 5. A price feed for each reward asset and for the native asset. The adapter refuses to
#    trade without one, so a quarter with no feed cannot pay out.
# 6. Confirmation that the reward assets can actually be held and transferred by a
#    contract. Run `script/PreflightAssets.s.sol` against a fork once 1-5 are known.
#
# Point 6 is the one that can end the project rather than delay it. See the note at the
# top of that script.
